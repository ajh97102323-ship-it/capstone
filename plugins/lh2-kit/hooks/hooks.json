{
  "description": "생성물(reports/, models/, data/datasets/) 직접 수정 차단, 재귀 삭제 차단, physics/ 수정 시 확인",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/guard_protected.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
